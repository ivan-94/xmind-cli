Usage: xmind copy [OPTIONS] --node <NODE> --to <TO> <--dry-run|--apply> <WORKBOOK>

Arguments:
  <WORKBOOK>  

Options:
      --node <NODE>                
      --to <TO>                    
      --title <TITLE>              
      --position <POSITION>        
      --preserve-ids               
      --dry-run                    
      --apply                      
      --backup                     
      --json                       
      --format <FORMAT>            [default: text] [possible values: text, json, compact-json, markdown, outline]
      --fields <FIELDS>            
      --quiet                      
      --no-color                   
      --sheet <SHEET>              
      --sheet-id <SHEET_ID>        
      --sheet-index <SHEET_INDEX>  

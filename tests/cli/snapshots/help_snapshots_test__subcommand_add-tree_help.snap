Usage: xmind add-tree [OPTIONS] --parent <PARENT> <--dry-run|--apply> <WORKBOOK>

Arguments:
  <WORKBOOK>  

Options:
      --parent <PARENT>                
      --input <INPUT>                  
      --from-markdown <FROM_MARKDOWN>  
      --markdown-mode <MARKDOWN_MODE>  
      --dry-run                        
      --apply                          
      --backup                         
      --json                           
      --format <FORMAT>                [default: text] [possible values: text, json, compact-json, markdown, outline]
      --fields <FIELDS>                
      --quiet                          
      --no-color                       
      --sheet <SHEET>                  
      --sheet-id <SHEET_ID>            
      --sheet-index <SHEET_INDEX>      
  -h, --help                           Print help
